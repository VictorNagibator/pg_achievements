-- null_eq: counted even though the query returns nothing
SELECT id FROM t1 WHERE a = NULL;
NOTICE:  [BRONZE] Achievement unlocked: NULL Is Not Equal to NULL (+10)
DETAIL:  Compare with = NULL instead of IS NULL. Total score: 115.
 id 
----
(0 rows)

-- update_no_where / delete_no_where: counted at analysis, even on failure
UPDATE t1 SET a = a;
NOTICE:  [GOLD] Achievement unlocked: Forgot WHERE (+50)
DETAIL:  UPDATE without a WHERE clause. Total score: 165.
BEGIN;
DELETE FROM t2;
NOTICE:  [GOLD] Achievement unlocked: Forgot WHERE, Part 2 (+50)
DETAIL:  DELETE without a WHERE clause. Total score: 215.
ROLLBACK;
NOTICE:  [BRONZE] Achievement unlocked: Ctrl+Z (+10)
DETAIL:  Roll back a transaction with ROLLBACK. Total score: 225.
UPDATE t1 SET a = 1 / 0;
ERROR:  division by zero
-- with WHERE: nothing
UPDATE t1 SET a = a WHERE id = 1;
-- terminate_backend (pid -1 does not exist, the call still succeeds)
SELECT pg_terminate_backend(-1);
WARNING:  PID -1 is not a PostgreSQL backend process
NOTICE:  [GOLD] Achievement unlocked: Executioner (+50)
DETAIL:  Call pg_terminate_backend. Total score: 275.
 pg_terminate_backend 
----------------------
 f
(1 row)

-- upsert and returning; DELETE ... RETURNING * is not a SELECT *
INSERT INTO t1 VALUES (1, 1) ON CONFLICT (id) DO NOTHING;
NOTICE:  [BRONZE] Achievement unlocked: Upsert Happens (+10)
DETAIL:  Run INSERT ... ON CONFLICT. Total score: 285.
INSERT INTO t1 VALUES (11, 11) ON CONFLICT (id) DO UPDATE SET a = EXCLUDED.a RETURNING id;
NOTICE:  [BRONZE] Achievement unlocked: Returning Hero (+10)
DETAIL:  Use RETURNING in a data-modifying statement. Total score: 295.
 id 
----
 11
(1 row)

DELETE FROM t1 WHERE id = 11 RETURNING *;
 id | a  | j 
----+----+---
 11 | 11 | 
(1 row)

