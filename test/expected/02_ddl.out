CREATE TABLE d1 (id int, v int);
NOTICE:  [BRONZE] Achievement unlocked: First Table (+10)
DETAIL:  Create your first table. Total score: 45.
CREATE TABLE IF NOT EXISTS d1 (id int);   -- exists: not counted
NOTICE:  relation "d1" already exists, skipping
CREATE TABLE d2 AS SELECT 1 AS id;
CREATE INDEX d1_v ON d1 (v);
NOTICE:  [BRONZE] Achievement unlocked: Indexer (+10)
DETAIL:  Create your first index. Total score: 55.
CREATE INDEX CONCURRENTLY d1_id ON d1 (id);
NOTICE:  [SILVER] Achievement unlocked: No Locks (+25)
DETAIL:  Create an index CONCURRENTLY. Total score: 80.
CREATE FUNCTION d_trg() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$;
NOTICE:  [BRONZE] Achievement unlocked: Functionary (+10)
DETAIL:  Create your first function or procedure. Total score: 90.
CREATE PROCEDURE d_proc() LANGUAGE sql AS $$ SELECT 1 $$;
CREATE TRIGGER d1_trg BEFORE INSERT ON d1 FOR EACH ROW EXECUTE FUNCTION d_trg();
NOTICE:  [SILVER] Achievement unlocked: Trigger Happy (+25)
DETAIL:  Create a trigger. Total score: 115.
CREATE TABLE dp (id int) PARTITION BY RANGE (id);
NOTICE:  [SILVER] Achievement unlocked: Divide and Conquer (+25)
DETAIL:  Create a partitioned table or a partition. Total score: 140.
CREATE TABLE dp_1 PARTITION OF dp FOR VALUES FROM (0) TO (100);
TRUNCATE d1;
NOTICE:  [GOLD] Achievement unlocked: Clean Slate (+50)
DETAIL:  TRUNCATE a table. Total score: 190.
VACUUM d1;              -- plain VACUUM: not counted
VACUUM (FULL) d1;
NOTICE:  [GOLD] Achievement unlocked: Master of the Table (+50)
DETAIL:  Run VACUUM FULL. Total score: 240.
CREATE EXTENSION IF NOT EXISTS plpgsql;    -- exists: not counted
