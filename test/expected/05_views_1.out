-- Views and privileges.
SELECT achievements.sync();
 sync 
------
 t
(1 row)

-- an unprivileged role sees its own data through the views only
SELECT pga_test_role('t_view');
 pga_test_role 
---------------
 
(1 row)

SET ROLE t_view;
SELECT * FROM achievements.counters;
ERROR:  permission denied for table counters
SELECT * FROM achievements.awarded;
ERROR:  permission denied for table awarded
UPDATE achievements.catalog SET points = 1000;
NOTICE:  [GOLD] Achievement unlocked: Forgot WHERE (+50)
DETAIL:  UPDATE without a WHERE clause. Total score: 50.
Unlocked by 2 of 6 players (33%).
ERROR:  permission denied for table catalog
SELECT count(*) FROM achievements.my;
NOTICE:  [BRONZE] Achievement unlocked: Hello, World (+10)
DETAIL:  Run your first SELECT. Total score: 60.
Unlocked by 6 of 6 players (100%).
 count 
-------
     0
(1 row)

RESET ROLE;
-- my: t_ddl holds a secret achievement (yolo)
SET ROLE t_ddl;
SELECT tier, title, points, code FROM achievements.my ORDER BY tier, code;
  tier  |        title        | points |        code        
--------+---------------------+--------+--------------------
 bronze | Ctrl+Z              |     10 | ctrl_z
 bronze | Investigator        |     10 | first_explain
 bronze | Functionary         |     10 | first_function
 bronze | Indexer             |     10 | first_index
 bronze | First Table         |     10 | first_table
 bronze | Hello, World        |     10 | hello_world
 bronze | Self-Documenting    |     10 | self_documenting
 silver | Are You Listening?  |     25 | are_you_listening
 silver | Big Brother         |     25 | big_brother
 silver | Detective           |     25 | detective
 silver | Divide and Conquer  |     25 | divide_and_conquer
 silver | Materialist         |     25 | materialist
 silver | No Locks            |     25 | no_locks
 silver | Save Point          |     25 | save_point
 silver | Trigger Happy       |     25 | trigger_happy
 gold   | Clean Slate         |     50 | clean_slate
 gold   | Friday Deploy       |     50 | friday_deploy
 gold   | Lock Hoarder        |     50 | lock_hoarder
 gold   | Novelist            |     50 | novelist
