DETAIL:  Run a query with an explicit JOIN. Total score: 105.
 count 
-------
    10
(1 row)

SELECT count(*) FROM t1 a JOIN t2 b ON b.t1_id = a.id JOIN t1 c ON c.id = b.id;
 count 
-------
    10
(1 row)

SELECT count(*) FROM t1 JOIN t2 ON t2.t1_id = t1.id;
