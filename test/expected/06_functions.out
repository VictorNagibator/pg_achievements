RESET ROLE;
-- define a custom achievement on an existing counter
SELECT achievements.define('truncator', 'Truncator', 'TRUNCATE 2 tables.', 'silver', 'truncate', 2);
 define 
--------
 
(1 row)

SELECT achievements.define('bad', 'Bad', 'Bad.', 'silver', 'no_such_counter', 2);
