-------------
 first_cte
 first_table
 hello_world
(3 rows)

-- emoji style (the database and the client use UTF8)
SET pg_achievements.notice_style = emoji;
SELECT id, rank() OVER (ORDER BY id) FROM (VALUES (1)) v(id);
NOTICE:  🥈 [SILVER] Achievement unlocked: Open Window (+25)
DETAIL:  Use a window function. Total score: 55.
 id | rank 
----+------
  1 |    1
(1 row)

RESET pg_achievements.notice_style;
-- reset: own progress yes, someone else's no
SELECT achievements.reset('t_other');
ERROR:  only a superuser can reset achievements of another role
CONTEXT:  SQL statement "SELECT achievements._reset(role)"
PL/pgSQL function achievements.reset(name) line 3 at PERFORM
-- the SELECT calling reset() is itself the first statement after the reset,
-- so Hello, World is earned again right away
SELECT achievements.reset();
NOTICE:  [BRONZE] Achievement unlocked: Hello, World (+10)
DETAIL:  Run your first SELECT. Total score: 10.
 reset 
-------
 
(1 row)

