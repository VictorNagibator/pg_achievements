-- progress: secret descriptions are hidden until unlocked
SELECT code, description, threshold, current, unlocked
FROM achievements.progress
WHERE code IN ('yolo', 'time_machine', 'first_table', 'table_collector', 'gold_rush')
ORDER BY code;
      code       |           description           | threshold | current | unlocked 
-----------------+---------------------------------+-----------+---------+----------
 first_table     | Create your first table.        |         1 |      12 | t
 gold_rush       | Collect every gold achievement. |           |         | f
 table_collector | Create 100 tables.              |       100 |      12 | f
 time_machine    | ???                             |         1 |       0 | f
 yolo            | Drop a database.                |         1 |       1 | t
(5 rows)

RESET ROLE;
-- catalog_public hides every secret description
SELECT code, title, description, tier, points
FROM achievements.catalog_public WHERE secret ORDER BY code;
      code       |       title        | description | tier | points 
-----------------+--------------------+-------------+------+--------
 happy_new_query | Happy New Query    | ???         | gold |     50
 marathon        | Marathon           | ???         | gold |     50
 novelist        | Novelist           | ???         | gold |     50
 regret          | Regret             | ???         | gold |     50
 serial_killer   | Serial Executioner | ???         | gold |     50
 time_machine    | Time Machine       | ???         | gold |     50
 unicode_artist  | Unicode Artist     | ???         | gold |     50
 yolo            | You Only Live Once | ???         | gold |     50
(8 rows)

-- leaderboard, then opt-out of t_err
SELECT role_name, score, achievements, bronze, silver, gold, platinum
FROM achievements.leaderboard WHERE role_name LIKE 't\_%' ORDER BY role_name;
 role_name | score | achievements | bronze | silver | gold | platinum 
-----------+-------+--------------+--------+--------+------+----------
 t_analyze |   530 |           20 |      8 |      6 |    6 |        0
 t_ddl     |   670 |           23 |      7 |      8 |    8 |        0
 t_err     |   110 |            3 |      1 |      0 |    2 |        0
 t_exec    |   215 |            8 |      4 |      1 |    3 |        0
(4 rows)

ALTER ROLE t_err SET pg_achievements.opt_out = on;
SELECT role_name FROM achievements.leaderboard WHERE role_name LIKE 't\_%' ORDER BY role_name;
 role_name 
-----------
 t_analyze
 t_ddl
 t_exec
(3 rows)

ALTER ROLE t_err RESET pg_achievements.opt_out;
