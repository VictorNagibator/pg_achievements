-- Earn every builtin achievement with a single role, including the meta
-- achievements.  Repetitive events are generated with \gexec.
CREATE ROLE t_all SUPERUSER LOGIN;
\c - t_all
NOTICE:  [BRONZE] Achievement unlocked: Welcome (+10)
DETAIL:  Connect to the server for the first time. Total score: 10.
Unlocked by 2 of 9 players (22%).
\set QUIET on
\o /dev/null
-- bronze
SELECT 1;
NOTICE:  [BRONZE] Achievement unlocked: Hello, World (+10)
DETAIL:  Run your first SELECT. Total score: 20.
Unlocked by 9 of 9 players (100%).
CREATE TABLE a_t (id int, j jsonb);
NOTICE:  [BRONZE] Achievement unlocked: First Table (+10)
DETAIL:  Create your first table. Total score: 30.
Unlocked by 4 of 9 players (44%).
CREATE INDEX ON a_t (id);
NOTICE:  [BRONZE] Achievement unlocked: Indexer (+10)
DETAIL:  Create your first index. Total score: 40.
Unlocked by 2 of 9 players (22%).
CREATE FUNCTION a_f() RETURNS int LANGUAGE sql AS 'SELECT 1';
NOTICE:  [BRONZE] Achievement unlocked: Functionary (+10)
DETAIL:  Create your first function or procedure. Total score: 50.
Unlocked by 3 of 9 players (33%).
WITH x AS (SELECT 1) SELECT * FROM x;
NOTICE:  [BRONZE] Achievement unlocked: WITH Love (+10)
DETAIL:  Run a query with a common table expression. Total score: 60.
Unlocked by 4 of 9 players (44%).
SELECT 1 FROM a_t JOIN a_t b USING (id);
NOTICE:  [BRONZE] Achievement unlocked: All Connected (+10)
DETAIL:  Run a query with an explicit JOIN. Total score: 70.
Unlocked by 4 of 9 players (44%).
EXPLAIN SELECT 1;
NOTICE:  [BRONZE] Achievement unlocked: Investigator (+10)
DETAIL:  Ask the planner with EXPLAIN. Total score: 80.
Unlocked by 2 of 9 players (22%).
SET pg_achievements.notify = off;   -- see 04_errors
SELECT 'SELEC ' || g FROM generate_series(1, 10) g \gexec
