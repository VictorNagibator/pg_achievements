SET ROLE t_fn;
CREATE TABLE fn_t (id int);
NOTICE:  [BRONZE] Achievement unlocked: First Table (+10)
DETAIL:  Create your first table. Total score: 70.
TRUNCATE fn_t;
NOTICE:  [GOLD] Achievement unlocked: Clean Slate (+50)
DETAIL:  TRUNCATE a table. Total score: 120.
TRUNCATE fn_t;
NOTICE:  [SILVER] Achievement unlocked: Truncator (+25)
DETAIL:  TRUNCATE 2 tables. Total score: 145.
RESET ROLE;
-- custom achievements do not change the meta ones
SELECT count(*) FROM achievements.catalog WHERE builtin;
 count 
