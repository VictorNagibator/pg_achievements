-- Counters detected at parse analysis and committed at ExecutorEnd.
SELECT pga_test_role('t_analyze');
 pga_test_role 
---------------
 
(1 row)

CREATE TABLE t1 (id int PRIMARY KEY, a int, j jsonb);
NOTICE:  [BRONZE] Achievement unlocked: First Table (+10)
DETAIL:  Create your first table. Total score: 140.
CREATE TABLE t2 (id int PRIMARY KEY, t1_id int);
INSERT INTO t1 SELECT g, g, jsonb_build_object('k', g) FROM generate_series(1, 10) g;
INSERT INTO t2 SELECT g, g FROM generate_series(1, 10) g;
GRANT ALL ON t1, t2 TO t_analyze;
SET ROLE t_analyze;
\set QUIET on
-- stmt_select
SELECT 1 AS one;
NOTICE:  [BRONZE] Achievement unlocked: Hello, World (+10)
DETAIL:  Run your first SELECT. Total score: 10.
 one 
-----
   1
(1 row)

-- select_star, also with a qualifier
SELECT * FROM t1 WHERE id = 1;
 id | a |    j     
----+---+----------
  1 | 1 | {"k": 1}
(1 row)

SELECT t1.* FROM t1 WHERE id = 1;
 id | a |    j     
----+---+----------
  1 | 1 | {"k": 1}
(1 row)

SELECT "t1".* FROM t1 WHERE id = 1;
 id | a |    j     
----+---+----------
  1 | 1 | {"k": 1}
(1 row)

-- not a star: column list, count(*), multiplication
SELECT id, a FROM t1 WHERE id = 1;
 id | a 
----+---
  1 | 1
(1 row)

SELECT count(*) FROM t1;
 count 
-------
    10
(1 row)

SELECT a * 2 FROM t1 WHERE id = 1;
 ?column? 
----------
        2
(1 row)

-- cte_any, cte_recursive
WITH x AS (SELECT 1 AS v) SELECT v FROM x;
NOTICE:  [BRONZE] Achievement unlocked: WITH Love (+10)
DETAIL:  Run a query with a common table expression. Total score: 20.
 v 
---
 1
(1 row)

WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 3)
SELECT count(*) FROM r;
NOTICE:  [SILVER] Achievement unlocked: Recursion: See Recursion (+25)
DETAIL:  Run a WITH RECURSIVE query. Total score: 45.
 count 
-------
     3
(1 row)

-- window_func
SELECT id, row_number() OVER (ORDER BY id) FROM t1 WHERE id < 3;
NOTICE:  [SILVER] Achievement unlocked: Open Window (+25)
DETAIL:  Use a window function. Total score: 70.
 id | row_number 
----+------------
  1 |          1
  2 |          2
(2 rows)

-- lateral
SELECT t1.id, s.x FROM t1, LATERAL (SELECT t1.a + 1 AS x) s WHERE t1.id = 1;
NOTICE:  [SILVER] Achievement unlocked: Lateral Thinking (+25)
DETAIL:  Use LATERAL. Total score: 95.
 id | x 
----+---
  1 | 2
(1 row)

-- jsonb_ops: four operators in one query, then one more
SELECT j -> 'k', j ->> 'k', j @> '{"k": 1}', j ? 'k' FROM t1 WHERE id = 1;
 ?column? | ?column? | ?column? | ?column? 
----------+----------+----------+----------
 1        | 1        | t        | t
(1 row)

SELECT j -> 0 FROM t1 WHERE id = 1;
 ?column? 
